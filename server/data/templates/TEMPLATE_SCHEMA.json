{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mihwar.local/schemas/government-project-template-catalog-v1.json",
  "title": "MIHWAR 200 project templates v1",
  "type": "object",
  "required": ["schema_version", "template_count", "category_count", "templates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "template_count": {"const": 200},
    "category_count": {"const": 20},
    "templates": {
      "type": "array", "minItems": 200, "maxItems": 200,
      "items": {"$ref": "#/$defs/template"}
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "phase_id", "name", "kind", "duration_workdays", "depends_on", "responsible_role", "can_assign_cross_org", "assignee_user_id", "assigned_org_id", "evidence_required"],
      "properties": {
        "id": {"type": "string"},
        "phase_id": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["INTERNAL_TASK", "INTERAGENCY_REQUEST_CANDIDATE", "MILESTONE_GATE"]},
        "duration_workdays": {"type": "integer", "minimum": 0},
        "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "responsible_role": {"type": "string"},
        "can_assign_cross_org": {"const": false},
        "assignee_user_id": {"type": "null"},
        "assigned_org_id": {"type": "null"},
        "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cross_agency_request": {"type": ["object", "null"]}
      }
    },
    "phase": {
      "type": "object",
      "required": ["id", "name", "order", "duration_workdays_estimate", "stage_gate_task_id"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "order": {"type": "integer", "minimum": 1},
        "duration_workdays_estimate": {"type": "integer", "minimum": 0},
        "stage_gate_task_id": {"type": "string"}
      }
    },
    "template": {
      "type": "object",
      "required": ["id", "version", "sector_id", "sector_name_ar", "specialty_name_ar", "name_ar", "estimated_total_workdays", "phase_count", "task_count", "phases", "tasks", "template_binding_rules"],
      "properties": {
        "id": {"type": "string", "pattern": "^TPL-[0-9]{3}$"},
        "version": {"type": "string"},
        "sector_id": {"type": "string"},
        "sector_name_ar": {"type": "string"},
        "specialty_name_ar": {"type": "string"},
        "name_ar": {"type": "string", "minLength": 1},
        "estimated_total_workdays": {"type": "integer", "minimum": 0},
        "phase_count": {"const": 6},
        "task_count": {"const": 18},
        "phases": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/phase"}},
        "tasks": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"$ref": "#/$defs/task"}},
        "template_binding_rules": {
          "type": "object",
          "required": ["project_insertion_state", "interagency_requests_are_drafts", "no_cross_org_person_assignment", "no_silent_approval"],
          "properties": {
            "project_insertion_state": {"const": "DRAFT"},
            "interagency_requests_are_drafts": {"const": true},
            "no_cross_org_person_assignment": {"const": true},
            "no_silent_approval": {"const": true}
          }
        }
      }
    }
  }
}
